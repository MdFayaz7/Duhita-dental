# Copy to .env and fill in
# Postgres. postgres:// URLs from Coolify work as-is; ?sslmode=require is fine too.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/duhita_dental

# Change these before going live
ADMIN_USERNAME=DuhitaAdmin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Comma-separated list of sites allowed to call the API
CORS_ORIGINS=http://localhost:5180,http://localhost:5173,https://duhitadental.com
# Optional: a regex to allow additional origins beyond the exact list above.
CORS_ORIGIN_REGEX=
PUBLIC_BASE_URL=http://localhost:8000

# Optional but recommended for patient feedback videos: free Cloudinary account →
# Dashboard → "API environment variable". Without it, clips must be under 20 MB.
CLOUDINARY_URL=

# WhatsApp Cloud API (Meta) — booking alerts with a Confirm button, and patient confirmations.
# Leave WHATSAPP_TOKEN empty to log messages instead of sending them. Setup: backend/README.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Who gets booking alerts and may tap Confirm (comma-separated, 10-digit or with country code)
WHATSAPP_ADMIN_NUMBERS=
WHATSAPP_TEMPLATE_ADMIN=appointment_request
WHATSAPP_TEMPLATE_PATIENT=appointment_confirmed
WHATSAPP_LANGUAGE=en

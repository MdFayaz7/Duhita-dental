# Copy to .env and fill in
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_DB=duhita_dental

# Change these before going live
ADMIN_USERNAME=DuhitaAdmin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Comma-separated list of sites allowed to call the API
CORS_ORIGINS=http://localhost:5180,http://localhost:5173
# Optional: allow Vercel preview deployments, e.g. ^https://duhita-dental(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=
PUBLIC_BASE_URL=http://localhost:8000

# Optional but recommended for patient feedback videos: free Cloudinary account →
# Dashboard → "API environment variable". Without it, clips must be under 20 MB.
CLOUDINARY_URL=

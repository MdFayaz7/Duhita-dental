# Brain (set at least one)
# Google Gemini — FREE key, fastest + best Telugu: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq — FREE key, voice-to-text (Whisper) + fast English replies: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter — backup, free models
OPENROUTER_API_KEY=
# Comma-separated fallback chain. Defaults to free models; with credit, google/gemini-3.5-flash is faster and better at Telugu.
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free

# Voice: free Microsoft Edge neural voices (no key needed)
VOICE_EN=en-IN-NeerjaExpressiveNeural
VOICE_TE=te-IN-ShrutiNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# Optional shared secret; set the same value as EXPO_PUBLIC_APP_TOKEN in the app
APP_TOKEN=
PORT=8787

# Clinic the assistant refers patients to (only when a visit is really needed)
CLINIC_NAME=Duhita Dental Care
CLINIC_CITY=Vijayawada
CLINIC_NAME_TE=విజయవాడలోని దుహిత డెంటల్ కేర్
